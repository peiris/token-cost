#!/usr/bin/env python3
"""Launch the token-cost UI, whichever copy of the plugin is current.

Symlink this into your PATH once:

    ln -s <plugin>/scripts/token-cost ~/.local/bin/token-cost

It deliberately does not run the tui.py sitting next to it. Claude Code caches
each plugin version in its own directory, so the copy beside this file is
whatever version was installed the day you made the symlink -- and after the
next update that directory is stale, or gone. Resolving the newest install at
run time means the symlink keeps working and keeps being current.

Python, not shell, because python3 is already a requirement and this needs to
read a JSON file and compare version numbers.
"""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path

PLUGIN = "token-cost@token-cost"


def claude_dir() -> Path:
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(env).expanduser() if env else Path.home() / ".claude"


def from_install_record() -> Path | None:
    """Where Claude Code says the plugin is installed."""
    record = claude_dir() / "plugins" / "installed_plugins.json"
    try:
        with open(record, encoding="utf-8") as fh:
            entries = json.load(fh).get("plugins", {}).get(PLUGIN) or []
    except (OSError, ValueError, AttributeError):
        return None
    for entry in entries:
        path = entry.get("installPath")
        if path and (Path(path) / "scripts" / "tui.py").is_file():
            return Path(path)
    return None


def version_key(name: str):
    return [int(part) for part in re.findall(r"\d+", name)] or [0]


def newest_in_cache() -> Path | None:
    """The highest version sitting in the plugin cache."""
    cache = claude_dir() / "plugins" / "cache" / "token-cost" / "token-cost"
    if not cache.is_dir():
        return None
    versions = [d for d in cache.iterdir()
                if (d / "scripts" / "tui.py").is_file()]
    return max(versions, key=lambda d: version_key(d.name), default=None)


def plugin_root() -> Path | None:
    override = os.environ.get("TOKEN_COST_ROOT")
    if override:
        return Path(override).expanduser()
    # resolve() follows the symlink, so a clone works without an install.
    beside = Path(__file__).resolve().parent.parent
    return (from_install_record() or newest_in_cache()
            or (beside if (beside / "scripts" / "tui.py").is_file() else None))


def main() -> int:
    root = plugin_root()
    if root is None:
        print("token-cost: can't find the plugin. Install it with"
              " /plugin install token-cost@token-cost, or set TOKEN_COST_ROOT"
              " to a checkout.", file=sys.stderr)
        return 1
    tui = root / "scripts" / "tui.py"
    if not tui.is_file():
        print(f"token-cost: no UI at {tui}", file=sys.stderr)
        return 1
    os.execv(sys.executable, [sys.executable, str(tui), *sys.argv[1:]])


if __name__ == "__main__":
    sys.exit(main())
